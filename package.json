{
  "name": "skvk",
  "version": "1.0.0",
  "description": "SKVK - free job application tracker dashboard with MongoDB backend",
  "main": "api/index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:resume": "node scripts/seed-resume.js",
    "test": "python3 test/test_parser.py && node scripts/check-ui-contract.js",
    "parser:dev": "cd api && PARSER_ALLOW_ANONYMOUS=true python3 -m _resume_parser.server",
    "parser:install": "pip install -r requirements.txt",
    "corpus": "python3 test/corpus/score.py -v",
    "corpus:render": "python3 test/corpus/render.py",
    "check:ui": "node scripts/check-ui-contract.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonrepair": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "mongoose": "^8.5.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20.16.0"
  }
}
