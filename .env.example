# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB connection string (Atlas or self-hosted). Required.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skvk

# Secret used to sign session JWTs. REQUIRED — at least 16 characters.
#
# Without this, login and registration return 503 naming this variable
# (before, they returned an opaque 500). On Vercel this must be set in
# Project Settings -> Environment Variables, then redeployed — a local .env
# is not uploaded.
# The Python parser functions verify the SAME token, so this value must match
# in both runtimes (Vercel injects it into both automatically).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Groq API key(s) that power resume parsing, tailoring, and job analysis.
# Set GROQ_API_KEY for a single key, or GROQ_API_KEYS as a comma-separated
# list to round-robin across multiple keys (recommended if you're hitting
# per-key rate limits). At least one is required for AI features to work.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEYS=

# Optional: override the Groq model used for all AI calls. Defaults to
# "openai/gpt-oss-120b" if unset.
GROQ_MODEL=openai/gpt-oss-120b

# Local dev server port (Vercel ignores this in production).
PORT=4000

# Extension base URL. Use your deployed Vercel origin in production.
APP_BASE_URL=http://localhost:4000

# Groq resume parser request-size safety (keeps parsing below common TPM limits)
GROQ_PARSE_MAX_COMPLETION=2200
GROQ_SAFE_INPUT_CHARS=18000

# ─── Resume parser (Python) ───────────────────────────────────────────────
# The parser needs no API key — it is deterministic and uses no AI.
# JWT_SECRET above is the only variable it requires.

# Local development only: skip session verification when running the parser
# standalone via `npm run parser:dev`. Never set this in a deployment.
PARSER_ALLOW_ANONYMOUS=

# Port for the standalone parser server (npm run parser:dev / Docker).
# PORT=8080
