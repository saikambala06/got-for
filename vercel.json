{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    {
      "src": "api/parser/*.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "api/**" }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/parser/health", "dest": "api/parser/health.py" },
    { "src": "/api/parser/upload", "dest": "api/parser/upload.py" },
    { "src": "/api/parser/text", "dest": "api/parser/text.py" },
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
